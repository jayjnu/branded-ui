{
  "name": "@jayjnu/branded-ui-checker",
  "version": "0.1.0",
  "description": "Static composition checks for Branded UI projects.",
  "type": "module",
  "bin": {
    "branded-ui-check": "./dist/cli.js"
  },
  "files": ["dist"],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test test/*.test.mjs"
  },
  "dependencies": {
    "typescript": "catalog:"
  },
  "devDependencies": {
    "@jayjnu/branded-ui-repo-tools": "workspace:*",
    "@types/node": "catalog:"
  },
  "keywords": ["typescript", "lint", "architecture"],
  "author": "Jin Woo Jung",
  "license": "MIT"
}
